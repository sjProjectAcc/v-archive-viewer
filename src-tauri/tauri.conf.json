{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V-ARCHIVE Viewer",
  "version": "0.1.2",
  "identifier": "net.varchive.viewer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "V-ARCHIVE Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://djmax.gg data: blob:; connect-src 'self' https://v-archive.net https://djmax.gg; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
